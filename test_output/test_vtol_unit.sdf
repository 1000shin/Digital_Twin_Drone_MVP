<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="test_vtol_unit">
    <pose>0 0 0.15 0 0 0</pose>
    <!-- Gazebo Lift & Drag Aerodynamic System Plugin -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.05</a0>
      <cla>4.75</cla>
      <cda>0.03</cda>
      <cma>-1.8</cma>
      <alpha_stall>0.33</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>2.5</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.300</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>main_wing</link_name>
    </plugin>
    

  <!-- Main Fuselage Body -->
  <link name="base_link">
    <inertial>
      <mass value="0.3350"/>
      <inertia ixx="0.000681" ixy="0" ixz="0" iyy="0.005932" iyz="0" izz="0.006055"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.45 0.12 0.10"/>
      </geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.45 0.12 0.10"/></geometry>
    </collision>
  </link>
  <!-- Main Aerodynamic Wings -->
  <link name="main_wing">
    <inertial>
      <mass value="0.0540"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.250 1.200 0.02"/>
      </geometry>
      <material name="cyan"><color rgba="0.0 0.7 0.9 1.0"/></material>
    </visual>
  </link>
  <joint name="joint_fuselage_wing" type="fixed">
    <parent link="base_link"/>
    <child link="main_wing"/>
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
  </joint>
  <!-- Tilt Servo Motor Mount 0 -->
  <link name="tilt_servo_0">
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.05" radius="0.015"/></geometry>
      <material name="red"><color rgba="0.9 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="joint_tilt_0" type="revolute">
    <parent link="main_wing"/>
    <child link="tilt_servo_0"/>
    <origin xyz="0.10 0.545 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.5708" effort="2.0" velocity="3.0"/>
  </joint>
  <!-- Tilt Servo Motor Mount 1 -->
  <link name="tilt_servo_1">
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><cylinder length="0.05" radius="0.015"/></geometry>
      <material name="red"><color rgba="0.9 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="joint_tilt_1" type="revolute">
    <parent link="main_wing"/>
    <child link="tilt_servo_1"/>
    <origin xyz="0.10 -0.545 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.5708" effort="2.0" velocity="3.0"/>
  </joint>

  </model>
</sdf>