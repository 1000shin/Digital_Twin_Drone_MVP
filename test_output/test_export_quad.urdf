<?xml version="1.0"?>
<robot name="test_export_quad">
  <!-- Base Link / Central Hub -->
  <link name="base_link">
    <inertial>
      <mass value="0.2000"/>
      <inertia ixx="0.000482" ixy="0" ixz="0" iyy="0.000482" iyz="0" izz="0.000750"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.15 0.15 0.08"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.15 0.08"/>
      </geometry>
    </collision>
  </link>
  <!-- Arm 0 -->
  <link name="arm_0">
    <inertial>
      <mass value="0.0225"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0002"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.200" radius="0.01"/>
      </geometry>
      <material name="carbon"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="joint_base_arm_0" type="fixed">
    <parent link="base_link"/>
    <child link="arm_0"/>
    <origin xyz="0.1000 0.0000 0.0" rpy="0 1.5708 0.0000"/>
  </joint>
