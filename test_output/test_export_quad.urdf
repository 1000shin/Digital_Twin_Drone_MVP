  </link>
  <joint name="joint_base_arm_1" type="fixed">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <origin xyz="0.0000 0.1000 0.0" rpy="0 1.5708 1.5708"/>
  </joint>
  <!-- Arm 2 -->
  <link name="arm_2">
