<?xml version="1.0"?>
<robot name="evolved_shield_sentinel_v3">
  <!-- Base Link: Central Ducted Monocoque Airframe -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.880"/>
      <inertia ixx="0.006805" ixy="0" ixz="0" iyy="0.006805" iyz="0" izz="0.011499"/>
    </inertial>
    <!-- Main Center Avionics Hub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
      <material name="carbon_fiber">
        <color rgba="0.12 0.15 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
    </collision>
    <!-- Downward Optical Flow & Ground ToF Sensor -->
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.015"/>
      </geometry>
      <material name="sensor_lens">
        <color rgba="0.0 0.8 1.0 0.9"/>
      </material>
    </visual>
    <!-- Top 360 LiDAR Turret -->
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.08 0.08 0.12 1.0"/>
      </material>
    </visual>
    <!-- Nose Dual White Orientation Headlights -->
    <visual>
      <origin xyz="0.04 -0.075 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="headlight_white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="-0.04 -0.075 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="headlight_white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <!-- Tail Amber Strobe Beacon -->
    <visual>
      <origin xyz="0 0.075 0.02" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="tail_amber">
        <color rgba="0.96 0.62 0.04 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Arm 1 & Integrated Polycarbonate Duct Guard Ring -->
  <link name="arm_1">
    <inertial>
      <origin xyz="0.0900 0.0000 0" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- Structural Arm Carbon Rod -->
    <visual>
      <origin xyz="0.0900 0.0000 0" rpy="0 0 0.0000"/>
      <geometry>
        <box size="0.1800 0.022 0.018"/>
      </geometry>
      <material name="carbon_fiber"/>
    </visual>
    <!-- 360° Circular Ducted Bumper Guard (Shock Absorbing Collision Ring) -->
    <visual>
      <origin xyz="0.1800 0.0000 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.082" length="0.040"/>
      </geometry>
      <material name="polycarb_guard">
        <color rgba="0.1 0.4 0.8 0.35"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.1800 0.0000 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.082" length="0.040"/>
      </geometry>
    </collision>
    <!-- Aviation Navigation LED Beacon (Left=Red, Right=Green) -->
    <visual>
      <origin xyz="0.2016 0.0000 0.018" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.014"/>
      </geometry>
      <material name="nav_led_1">
        <color rgba="0.15 0.9 0.3 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="joint_arm_1" type="fixed">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 1 Link (Protected Inside Duct) -->
  <link name="rotor_1">
    <inertial>
      <origin xyz="0.1800 0.0000 0.01" rpy="0 0 0"/>
      <mass value="0.006"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000010"/>
    </inertial>
    <visual>
      <origin xyz="0.1800 0.0000 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.006"/>
      </geometry>
      <material name="prop_cyan">
        <color rgba="0.0 0.85 1.0 0.6"/>
      </material>
    </visual>
  </link>
  <joint name="joint_rotor_1" type="continuous">
    <parent link="arm_1"/>
    <child link="rotor_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Arm 2 & Integrated Polycarbonate Duct Guard Ring -->
