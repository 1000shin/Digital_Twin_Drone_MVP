<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="evolved_sentinel_prime_v4">
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.8200</mass>
        <inertia>
          <ixx>0.010202</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.010202</iyy>
          <iyz>0</iyz>
          <izz>0.014801</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <box><size>0.12 0.12 0.055</size></box>
        </geometry>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>0.12 0.12 0.055</size></box>
        </geometry>
      </collision>
      <sensor name="lidar_360" type="ray">
        <pose>0 0 0.05 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>12.0</max>
          </range>
        </ray>
      </sensor>
    </link>

    <link name="arm_1">
      <pose>0.1650 0.0000 0.05 0 0 0</pose>
      <collision name="duct_bumper_1_collision">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="duct_bumper_1_visual">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="joint_arm_1" type="fixed">
      <parent>base_link</parent>
      <child>arm_1</child>
    </joint>

    <link name="arm_2">
      <pose>0.0000 0.1650 0.05 0 0 0</pose>
      <collision name="duct_bumper_2_collision">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="duct_bumper_2_visual">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="joint_arm_2" type="fixed">
      <parent>base_link</parent>
      <child>arm_2</child>
    </joint>

    <link name="arm_3">
      <pose>-0.1650 0.0000 0.05 0 0 0</pose>
      <collision name="duct_bumper_3_collision">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="duct_bumper_3_visual">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="joint_arm_3" type="fixed">
      <parent>base_link</parent>
      <child>arm_3</child>
    </joint>

    <link name="arm_4">
      <pose>-0.0000 -0.1650 0.05 0 0 0</pose>
      <collision name="duct_bumper_4_collision">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="duct_bumper_4_visual">
        <geometry>
          <cylinder>
            <radius>0.0780</radius>
            <length>0.0420</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="joint_arm_4" type="fixed">
      <parent>base_link</parent>
      <child>arm_4</child>
    </joint>

    <plugin name="px4_multirotor_dynamics" filename="libgazebo_multirotor_dynamics_plugin.so">
      <robotNamespace>evolved_sentinel_prime_v4</robotNamespace>
      <autonomousPolicyActive>true</autonomousPolicyActive>
      <bumperThicknessMm>2.5</bumperThicknessMm>
    </plugin>
  </model>
</sdf>
